# Discord bot token (Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=

# Your Discord user ID — only this user can issue commands
OWNER_DISCORD_ID=

# The private server (guild) ID where the bot lives — commands sync only here, never globally
GUILD_ID=

# Optional: override project root (defaults to the repo directory itself)
# MEGATRON_HOME=/home/kali/megatron

# Optional: override auto-detected tool paths (useful if a tool is a snap/odd install)
# TOOL_PATH_SUBFINDER=/home/kali/go/bin/subfinder
# TOOL_PATH_HTTPX=/snap/bin/httpx
# TOOL_PATH_NUCLEI=/home/kali/go/bin/nuclei
# TOOL_PATH_KATANA=/home/kali/go/bin/katana
# TOOL_PATH_GAU=/home/kali/go/bin/gau
# TOOL_PATH_FFUF=/usr/bin/ffuf
# TOOL_PATH_SQLMAP=/usr/bin/sqlmap
# TOOL_PATH_DALFOX=/home/kali/go/bin/dalfox
# TOOL_PATH_NMAP=/usr/bin/nmap
# TOOL_PATH_CLAUDE=/home/kali/.nvm/versions/node/v23.11.0/bin/claude

# Max concurrent jobs the queue worker will run at once
MEGATRON_MAX_CONCURRENT_JOBS=1

# How many claude -p invocations are allowed per rolling 24h window
MEGATRON_CLAUDE_DAILY_BUDGET=20

# claude backend: "cli" (Pro plan headless CLI, default) or "api" (ANTHROPIC_API_KEY billing)
MEGATRON_CLAUDE_BACKEND=cli
# ANTHROPIC_API_KEY=

# Hard cost cap per single claude -p call when MEGATRON_CLAUDE_BACKEND=api (passed as --max-budget-usd)
MEGATRON_API_CALL_COST_CAP_USD=1.00

# Independent kill switch, checked at process boot regardless of Discord/DB state
MEGATRON_EMERGENCY_STOP=0
